# ==============================================================================
# DATABASE CONFIGURATION (PostgreSQL / Supabase / Neon / Local Docker)
# ==============================================================================

# Option 1: Local PostgreSQL (using docker-compose or local server)
DATABASE_URL=""

# Option 2: Supabase (Transaction Pooler for DATABASE_URL & Session/Direct for DIRECT_URL)
# DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Option 3: Neon / Railway / Cloud SQL
# DATABASE_URL="postgresql://username:password@ep-cool-lake-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ==============================================================================
# AUTHENTICATION & SECURITY (NextAuth.js)
# ==============================================================================
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Optional: Google Workspace / Google OAuth for Education
# GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="your-google-client-secret"
